# Docify — copy to .env.local and fill values. Never commit .env.local.
# Public keys (NEXT_PUBLIC_*) are exposed to the browser. All others are server-only.

# Postgres (Neon / Supabase). Used by src/lib/db/index.ts + drizzle.config.ts
DATABASE_URL=postgresql://user:password@host:5432/docify

# Better-Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-char-secret
# Local dev:
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob. From Vercel dashboard → Storage → Blob → .env pull / token.
# @vercel/blob reads BLOB_READ_WRITE_TOKEN automatically.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace-me

# Google OAuth (optional — omit both to disable Google sign-in)
# From https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# VAPI voice AI (optional — voice is disabled if these are unset)
# From https://dashboard.vapi.ai → API Keys (public key) + Assistants (assistant ID)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=replace-me
NEXT_PUBLIC_ASSISTANT_ID=replace-me

# Rate limiting (optional). Without it, limits are per-instance memory,
# which is fine locally but not shared across serverless instances.
# From https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
